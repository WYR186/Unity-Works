###############################################################################
# Unity .gitignore (full, practical)
# Works for most Unity projects (Mac/Windows/Linux) + JetBrains/VSCode.
###############################################################################

# --- OS / System files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Unity generated folders ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Unity cache in project root (newer versions sometimes)
.vs/
.gradle/
*.svd

# --- Unity Addressables / Streaming caches (optional but usually safe) ---
# If you actually keep runtime content in StreamingAssets, DO NOT ignore that folder.
# [Ss]treamingAssets/aa/          # Addressables build output (often generated)
# [Aa]ssets/AddressableAssetsData/*/*.bin

# --- Crash reports / backups ---
crashlytics-build.properties
sysinfo.txt
*.stackdump

# --- Autogenerated meta when deleting assets (Unity keeps .meta; DO NOT ignore all .meta) ---
# Keep .meta files tracked; they are required for GUIDs.
# (So: do NOT put "*.meta" here.)

# --- Visual Studio / Rider / MonoDevelop generated ---
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Rider / IntelliJ
.idea/
*.iml

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Unity packages lock + manifest ---
# Keep these tracked (important for consistent deps)
!Packages/manifest.json
!Packages/packages-lock.json

# --- Unity Collaborate / Plastic SCM (if present) ---
.collabignore
.plastic/
.plasticworkspace/
*.plastic

# --- Unity Asset Store tools / package manager caches (generated) ---
AssetStoreTools/
Packages/com.unity.*.tgz

# --- Build results ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86
*.x86_64
*.dll
*.so
*.dylib
*.a
*.lib
*.ipa
*.dSYM/
*.dSYM.zip
*.symbols.zip

# --- WebGL builds ---
*.data
*.mem
*.wasm
*.framework.js
*.loader.js

# --- Logs ---
*.log

# --- Compressed / archives ---
*.zip
*.7z
*.rar
*.tar
*.gz
###############################################################################
# Additional rules for your specific project
###############################################################################

# Unity Android build temp files
.utmp/
**/.utmp/

# IL2CPP generated C++ output (massive, should never be committed)
**/il2cppOutput/
**/Il2CppOutput/

# Unity "BackUpThisFolder_ButDontShipItWithYourGame" - build artifacts
**/*BackUpThisFolder_ButDontShipItWithYourGame*/

# Burst compiler debug info
**/BurstDebugInformation_DoNotShip/

# Screen recordings / large media files (optional - uncomment if you want)
# *.mov
# *.mp4
# *.avi

# Android Gradle temp
**/gradleBuild/
**/.gradle/

# iOS build artifacts (if you build for iOS later)
**/iosBuild/
**/xcuserdata/
**/DerivedData/

# macOS specific
*.app/
*.dmg

# Windows specific
*.exe
*.pdb
###############################################################################
# Optional: If you use Git LFS for large assets, configure separately.
###############################################################################
